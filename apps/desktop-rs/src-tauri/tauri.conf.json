{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimePaws",
  "version": "0.1.0",
  "identifier": "com.timepaws.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimePaws",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "overlay",
        "title": "TimePaws 提醒",
        "url": "index.html#/overlay",
        "width": 320,
        "height": 148,
        "visible": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
